        <mxCell id="c64Q9XO2W0ZFJLCART8c-3" value="You can have one virtual warehouse for your ingestion workload , one for your BI workload etc." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
