        <mxCell id="c64Q9XO2W0ZFJLCART8c-2" value="At the centre there is storage and the cogs surrounding it reprersent the virtual warehouses (compute) that manage various workloads" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" vertex="1" parent="1">
